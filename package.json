{
  "name": "taskorgapp",
  "version": "1.0.0",
  "description": "A real-time shared task organizer for couples using the Eisenhower Matrix",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:api": "jest --testPathPattern=__tests__/api",
    "test:components": "jest --testPathPattern=__tests__/components",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "test:performance": "jest --testPathPattern=__tests__/performance",
    "test:database": "jest --testPathPattern=__tests__/database",
    "test:database:health": "node scripts/database-health-check.js",
    "clean": "rm -rf coverage test-results src/dist dist",
    "lint": "echo 'Linting not configured yet'",
    "type-check": "echo 'Type checking not configured yet'"
  },
  "keywords": [
    "task",
    "management",
    "eisenhower-matrix"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jsdom": "^27.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-html-reporter": "^3.10.2",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "jsdom": "^27.4.0",
    "playwright": "^1.40.0",
    "supertest": "^6.3.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.1"
  }
}
