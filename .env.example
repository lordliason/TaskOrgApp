# TaskOrgApp Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# OpenAI API Configuration
# Required for AI chat and task decomposition features
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify which OpenAI model to use (default: gpt-3.5-turbo)
# Valid options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-3.5-turbo

# SMS Reminder Configuration (Textbelt)
# Required for SMS reminder functionality
# Get your API key from https://textbelt.com
TEXTBELT_API_KEY=your_textbelt_api_key_here

# SMS Recipient Phone Numbers
# Optional: Override default phone numbers for SMS reminders
# Format: E.164 format (e.g., +18458289353)
# If not set, defaults to hardcoded values in appConfig.js
MARIO_PHONE=+18458289353
MARIA_PHONE=+15186185155

# Supabase Configuration
# These are typically configured in the frontend config.js file
# but can also be set here for server-side operations
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
