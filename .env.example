# TaskOrgApp Environment Variables
# Copy this file to .env and fill in your Supabase credentials

# Supabase Configuration
# Get these from your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Push Notifications (Web Push API)
# Generate VAPID keys at: https://web-push-codelab.glitch.me/
# Or use: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# For Supabase Edge Functions (add these in Supabase Dashboard > Edge Functions > Secrets)
# VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY=your-vapid-private-key-here
# VAPID_EMAIL=mailto:admin@yourapp.com
